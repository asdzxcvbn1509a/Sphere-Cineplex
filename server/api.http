### Theatre Reservation System — ตัวอย่างการเรียก API
### เปิดไฟล์นี้ใน VS Code แล้วติดตั้งส่วนขยาย "REST Client" จากนั้นกด "Send Request" เหนือแต่ละบล็อก
### ทำตามลำดับจากบนลงล่าง เพราะบล็อกหลัง ๆ ใช้ค่าจากบล็อกก่อนหน้า

@host = http://localhost:4000/api
@userPhone = 0891234567
@adminPhone = 0800000000

### ── ตรวจสถานะเซิร์ฟเวอร์ ─────────────────────────────
GET {{host}}/health

### ── 1. ขอรหัส OTP (โหมด dev จะคืน devCode มาให้เลย) ──
# @name requestOtp
POST {{host}}/auth/otp/request
Content-Type: application/json

{ "phone": "{{userPhone}}" }

### ── 2. ยืนยัน OTP → ได้ access token + refresh cookie ─
# @name login
POST {{host}}/auth/otp/verify
Content-Type: application/json

{ "phone": "{{userPhone}}", "code": "{{requestOtp.response.body.devCode}}" }

@token = {{login.response.body.accessToken}}

### ── 3. ข้อมูลตัวเอง ──────────────────────────────────
GET {{host}}/auth/me
Authorization: Bearer {{token}}

### ── 4. รายการภาพยนตร์ ────────────────────────────────
# @name movies
GET {{host}}/movies

### ── 5. รอบฉายของเรื่องแรก ────────────────────────────
# @name showtimes
GET {{host}}/showtimes?movieId={{movies.response.body.movies.0.id}}

### ── 6. ผังที่นั่งของรอบแรก ────────────────────────────
# @name seatmap
GET {{host}}/showtimes/{{showtimes.response.body.showtimes.0.id}}/seats

### ── 7. จองที่นั่ง (ถ้าที่นั่งถูกจองไปแล้วจะได้ 409 SEAT_TAKEN) ──
# @name booking
POST {{host}}/bookings
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "showtimeId": "{{showtimes.response.body.showtimes.0.id}}",
  "seatIds": ["{{seatmap.response.body.rows.0.seats.0.id}}"]
}

@bookingId = {{booking.response.body.booking.id}}

### ── 8. ข้อมูลชำระเงิน + PromptPay payload ────────────
GET {{host}}/payments/{{bookingId}}
Authorization: Bearer {{token}}

### ── 9. อัปโหลดสลิป (แก้ path ให้ชี้ไฟล์รูปจริงบนเครื่อง) ──
POST {{host}}/payments/{{bookingId}}/slip
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=----Boundary

------Boundary
Content-Disposition: form-data; name="slip"; filename="slip.png"
Content-Type: image/png

< ./uploads/example-slip.png
------Boundary--

### ── 10. รายการจองของฉัน ──────────────────────────────
GET {{host}}/bookings?scope=upcoming
Authorization: Bearer {{token}}

### ── 11. E-Ticket (ต้องชำระเงินสำเร็จแล้วเท่านั้น) ─────
GET {{host}}/bookings/{{bookingId}}/ticket
Authorization: Bearer {{token}}

### ── 12. ยกเลิกการจอง ─────────────────────────────────
POST {{host}}/bookings/{{bookingId}}/cancel
Authorization: Bearer {{token}}
Content-Type: application/json

{ "reason": "เปลี่ยนแผน" }


### ══════════ ฝั่งผู้ดูแลระบบ ══════════

### ── A1. ขอ OTP ของ admin ─────────────────────────────
# @name adminOtp
POST {{host}}/auth/otp/request
Content-Type: application/json

{ "phone": "{{adminPhone}}" }

### ── A2. ล็อกอิน admin ────────────────────────────────
# @name adminLogin
POST {{host}}/auth/otp/verify
Content-Type: application/json

{ "phone": "{{adminPhone}}", "code": "{{adminOtp.response.body.devCode}}" }

@adminToken = {{adminLogin.response.body.accessToken}}

### ── A3. ภาพรวมระบบ ───────────────────────────────────
GET {{host}}/admin/overview
Authorization: Bearer {{adminToken}}

### ── A4. คิวสลิปรอตรวจสอบ ─────────────────────────────
# @name queue
GET {{host}}/admin/payments?status=PENDING_VERIFICATION
Authorization: Bearer {{adminToken}}

### ── A5. อนุมัติสลิปรายการแรกในคิว ────────────────────
POST {{host}}/admin/payments/{{queue.response.body.payments.0.id}}/approve
Authorization: Bearer {{adminToken}}

### ── A6. ปฏิเสธสลิปรายการแรกในคิว ─────────────────────
POST {{host}}/admin/payments/{{queue.response.body.payments.0.id}}/reject
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "reason": "ยอดเงินไม่ตรงกับที่แจ้ง" }

### ── A7. การจองทั้งหมด ────────────────────────────────
GET {{host}}/admin/bookings
Authorization: Bearer {{adminToken}}

### ── A8. รายงานยอดขายรายวัน ───────────────────────────
GET {{host}}/admin/reports/sales?groupBy=day
Authorization: Bearer {{adminToken}}

### ── A9. อัตราที่นั่งเต็มของแต่ละรอบ ───────────────────
GET {{host}}/admin/reports/occupancy
Authorization: Bearer {{adminToken}}

### ── A10. เพิ่มรอบฉายใหม่ ─────────────────────────────
POST {{host}}/admin/showtimes
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "movieId": "{{movies.response.body.movies.0.id}}",
  "theatreId": "REPLACE_WITH_THEATRE_ID",
  "startsAt": "2026-12-25T19:00:00+07:00",
  "basePrice": 220
}
