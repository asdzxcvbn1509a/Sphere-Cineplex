# ตั้งค่าสำหรับ integration test (dotnet test --filter Category=Integration)
# คัดลอกเป็น .env.test แล้วแก้ <PASSWORD> ให้ตรงกับ PostgreSQL บนเครื่อง
#
# ⚠️ ต้องเป็นฐานข้อมูลแยกที่ชื่อลงท้ายด้วย _test เท่านั้น — เทสต์ล้างทุกตารางก่อนรันแต่ละเคส
#    (ตัวช่วยในเทสต์ปฏิเสธการรันถ้าชื่อฐานไม่ลงท้ายด้วย _test) ไม่ต้องสร้างฐานเอง เทสต์รัน EF migration ให้
#
# เทสต์อ่านไฟล์นี้ไฟล์เดียว ไม่หยิบค่าจาก .env ของเครื่องมาเติม — ค่าที่ต้องใช้จึงตั้งไว้ครบทุกตัว
# เทสต์จะได้ผลเหมือนกันทุกเครื่อง ไม่ขึ้นกับว่าใครปรับ .env ของตัวเองไว้อย่างไร

DATABASE_URL="postgresql://postgres:<PASSWORD>@localhost:5432/cinebook_test"
CLIENT_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

JWT_ACCESS_SECRET=test_access_secret_not_for_production
JWT_REFRESH_SECRET=test_refresh_secret_not_for_production
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# ค่าต่ำสุดที่ยอม — เทสต์สร้างผู้ใช้หลายคน hash เร็วขึ้นเยอะ
BCRYPT_ROUNDS=8
LOGIN_LIMIT=10
LOGIN_WINDOW_MINUTES=15
REGISTER_LIMIT=50
REGISTER_WINDOW_MINUTES=60
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_LIMIT=5
PASSWORD_RESET_WINDOW_MINUTES=60

SEAT_HOLD_MINUTES=10
REJECTED_RETRY_MINUTES=10
CANCEL_CUTOFF_HOURS=3
MAX_SEATS_PER_BOOKING=8
MAX_PENDING_BOOKINGS_PER_USER=3
SEAT_CHANGE_CUTOFF_MINUTES=30
MAX_SEAT_CHANGES_PER_BOOKING=2

# ว่างไว้เสมอ — เทสต์ต้องไม่ส่งอีเมลจริง
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CineBook Test <no-reply@example.com>"

PROMPTPAY_ID=0812345678
PROMPTPAY_MERCHANT_NAME=THEATRE RESERVATION

RECEIPT_ISSUER_NAME=Sphere Cineplex
RECEIPT_ISSUER_ADDRESS=

# แยกโฟลเดอร์ไฟล์อัปโหลดของเทสต์ ไม่ให้ปนกับสลิปจริง
UPLOAD_DIR=uploads-test
MAX_SLIP_SIZE_MB=5
# ว่างไว้เสมอ — เทสต์เก็บสลิปลงดิสก์ (UPLOAD_DIR ด้านบน) ไม่งั้นเทสต์จะอัปโหลดและลบไฟล์บน Blob จริง
AZURE_STORAGE_CONNECTION_STRING=
TRUST_PROXY=loopback
# ว่างไว้เสมอ — เทสต์ที่ต้องการให้บังคับส่ง secret สร้างแอปอีกตัวที่ตั้ง PROXY_SECRET เอง
PROXY_SECRET=
# งานเบื้องหลังปิดไว้ — เทสต์เรียก job เองในเคสที่ต้องการ (เหมือน createApp() ของเดิมที่ไม่เริ่ม jobs)
RUN_JOBS=false
