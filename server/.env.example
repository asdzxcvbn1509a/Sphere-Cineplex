# ค่าตั้งของ API (ASP.NET Core) — คัดลอกเป็น server/.env แล้วแก้ค่า
# ค่าที่ตั้งไว้ใน environment จริงแล้ว (shell, App Settings ของ Azure) ชนะค่าในไฟล์นี้เสมอ · ค่าว่าง = ไม่ได้ตั้ง
# ทุกตัวแปรและค่าเริ่มต้น: docs/configuration.md

# ---------- Database ----------
# แก้ <PASSWORD> เป็นรหัสผ่านของ user postgres บนเครื่องคุณ (รับทั้งแบบ URI นี้และ connection string ของ Npgsql)
# Azure Database for PostgreSQL ต้องต่อท้าย ?sslmode=require
DATABASE_URL="postgresql://postgres:<PASSWORD>@localhost:5432/theatre_reservation_v2"
# true = รัน migration ที่ยังไม่เคยรันทุกครั้งที่เปิดเครื่อง (ใช้บน Azure) · ตอนพัฒนาใช้ dotnet ef database update แทน
DB_MIGRATE_ON_START=false

# ---------- Server ----------
# Development / Production — dotnet run / dotnet watch ตั้ง Development ให้เองจาก launchSettings.json
# ไม่ได้ตั้ง = Production (ค่าเริ่มต้นของ ASP.NET Core)
# ASPNETCORE_ENVIRONMENT=Development
# พอร์ตเมื่อโฮสต์ไม่ได้กำหนดเอง (ASPNETCORE_URLS / ASPNETCORE_HTTP_PORTS ของโฮสต์ชนะ)
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# ใครอยู่หน้า API — ใช้ตัดสินว่าจะเชื่อ X-Forwarded-For แค่ไหน (ไอพีนี้คือกุญแจของ rate limit ทุกตัว)
# loopback = เชื่อเฉพาะ reverse proxy บนเครื่องเดียวกัน · ตัวเลข = จำนวน proxy ข้างหน้า (Azure App Service = 1)
# ห้ามตั้ง true ถ้าไม่แน่ใจ — ใครก็ปลอมไอพีหลบ rate limit ได้
# ค่าที่ถูกต้องคือ proxyHops ของ <URL ของเว็บ>/api/health (ดู DEPLOY.md)
TRUST_PROXY=loopback
# secret ที่ proxy/CDN ข้างหน้าแนบมากับทุกคำขอ (header x-proxy-secret) — ตั้งแล้ว API รับเฉพาะคำขอที่มีค่านี้ (ยกเว้น /api/health)
# ต้องยาวอย่างน้อย 32 ตัว · เว้นว่างเมื่อไม่มี proxy ที่แนบให้ (รวมถึงบน App Service ที่ผู้ใช้เข้าตรง)
PROXY_SECRET=
# false = ไม่เริ่มงานเบื้องหลัง (ปล่อยที่นั่งที่หมดเวลา, แจ้งเตือนก่อนฉาย) — เทสต์ตั้ง false
RUN_JOBS=true

# ---------- JWT ----------
# สร้างค่าใหม่ด้วย PowerShell: [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
# หรือ: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_me_with_a_random_64_char_hex_string
JWT_REFRESH_SECRET=replace_me_with_another_random_64_char_hex_string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# ---------- Business rules ----------
SEAT_HOLD_MINUTES=10
REJECTED_RETRY_MINUTES=10
CANCEL_CUTOFF_HOURS=3
MAX_SEATS_PER_BOOKING=8
# ถือที่นั่งค้าง (รอชำระ + รอตรวจสลิป) พร้อมกันได้กี่รายการต่อคน — กันบัญชีเดียววนจองกักที่นั่งทั้งโรง
MAX_PENDING_BOOKINGS_PER_USER=3
# ลูกค้าเปลี่ยนที่นั่งเองได้ถึงก่อนรอบฉายกี่นาที และได้กี่ครั้งต่อการจอง (ผู้ดูแลย้ายแทนได้โดยไม่ติดทั้งสองข้อ)
SEAT_CHANGE_CUTOFF_MINUTES=30
MAX_SEAT_CHANGES_PER_BOOKING=1

# ---------- บัญชีผู้ใช้ / รหัสผ่าน ----------
BCRYPT_ROUNDS=10                # ความแรงในการ hash รหัสผ่าน (8–15 · สูงขึ้น = ปลอดภัยขึ้นแต่ล็อกอินช้าลง)
LOGIN_LIMIT=10                  # ล็อกอินผิดได้กี่ครั้งต่อ (ไอพี + บัญชี) ครั้งที่สำเร็จไม่นับ
LOGIN_WINDOW_MINUTES=15         # กรอบเวลาที่ใช้นับ (นาที)
REGISTER_LIMIT=50               # สมัครได้กี่บัญชีต่อไอพี ในกรอบเวลาด้านล่าง (นับเฉพาะที่สำเร็จ)
REGISTER_WINDOW_MINUTES=60      # กรอบเวลาที่ใช้นับ (นาที)
PASSWORD_RESET_TTL_MINUTES=30   # อายุลิงก์ตั้งรหัสผ่านใหม่ที่ส่งทางอีเมล
PASSWORD_RESET_LIMIT=5          # ขอลิงก์ได้กี่ครั้งต่อ (ไอพี + อีเมล) ในกรอบเวลาด้านล่าง
PASSWORD_RESET_WINDOW_MINUTES=60

# ---------- อีเมลขาออก (ส่งลิงก์ตั้งรหัสผ่านใหม่ และใบเสร็จหลังอนุมัติสลิป) ----------
# ไม่ตั้ง SMTP_HOST = ยังไม่ส่งอีเมลจริง ตอนพัฒนาระบบจะพิมพ์เนื้อเมลพร้อมลิงก์ลง console ให้แทน
# ก่อนเปิดใช้งานจริงต้องตั้งค่าให้ครบ ไม่งั้นผู้ใช้ที่ลืมรหัสผ่านจะไม่ได้รับอีเมล และลูกค้าไม่ได้รับใบเสร็จทางอีเมล
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false               # true เมื่อใช้พอร์ต 465 (เข้ารหัสตั้งแต่เชื่อมต่อ) · 587 ใช้ false (STARTTLS)
SMTP_USER=
SMTP_PASS=
# ต้องเป็นที่อยู่เดียวกับ SMTP_USER (หรือ alias ที่ยืนยันแล้ว)
# Gmail ไม่ยอมให้ส่งในนามอีเมลอื่น จะเขียนทับหรือปฏิเสธทั้งฉบับ
MAIL_FROM="CineBook <no-reply@example.com>"
# ฐานของลิงก์ในอีเมล ต้องเป็น URL ที่ผู้ใช้เปิดจากเครื่องตัวเองได้ — ไม่ตั้งจะใช้ค่า CLIENT_ORIGIN
APP_URL=http://localhost:5173

# ---------- PromptPay ----------
# หมายเลขพร้อมเพย์ปลายทางที่ใช้สร้าง QR — ต้องเปลี่ยนเป็นบัญชีจริงของร้านก่อนเปิดใช้งาน
PROMPTPAY_ID=0812345678
PROMPTPAY_MERCHANT_NAME=THEATRE RESERVATION

# ---------- ใบเสร็จรับเงิน (E-Receipt) ----------
# ชื่อและที่อยู่ผู้ออกใบเสร็จ แสดงบนหน้าใบเสร็จและอีเมลใบเสร็จ (เว้นที่อยู่ว่างไว้ = ไม่แสดงบรรทัดที่อยู่)
RECEIPT_ISSUER_NAME=Sphere Cineplex
RECEIPT_ISSUER_ADDRESS=

# ---------- Uploads ----------
# โฟลเดอร์สลิปเมื่อไม่ได้ตั้ง Azure Blob (นับจาก server/)
UPLOAD_DIR=uploads
MAX_SLIP_SIZE_MB=5

# ---------- ที่เก็บสลิปบน Azure Blob Storage (ตอนขึ้นระบบจริง) ----------
# เว้นว่าง = เก็บสลิปลงดิสก์ที่ UPLOAD_DIR (พอสำหรับตอนพัฒนา)
# App Service ต้องตั้ง — ดิสก์ของแอปถูกล้างตอน deploy ใหม่ สลิปจะหาย (วิธีสร้าง storage account ดู DEPLOY.md)
# connection string มีสิทธิ์เต็มของ storage account — ตั้งไว้ที่ App Settings ของ API เท่านั้น
AZURE_STORAGE_CONNECTION_STRING=
# container แบบ private · สลิปเก็บใต้ prefix payments/ และ refunds/
AZURE_SLIP_CONTAINER=slips
