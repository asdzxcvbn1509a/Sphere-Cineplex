# ---------- Database ----------
# แก้ <PASSWORD> เป็นรหัสผ่านของ user postgres บนเครื่องคุณ
DATABASE_URL="postgresql://postgres:<PASSWORD>@localhost:5432/theatre_reservation_v2?schema=public"

# ---------- Server ----------
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
# ใครอยู่หน้า API — ใช้ตัดสินว่าจะเชื่อ X-Forwarded-For แค่ไหน (ไอพีนี้คือกุญแจของ rate limit ทุกตัว)
# loopback = เชื่อเฉพาะ reverse proxy บนเครื่องเดียวกัน · ตัวเลข = จำนวน proxy ข้างหน้า (เช่น load balancer 1 ชั้น = 1)
# ห้ามตั้ง true ถ้าไม่แน่ใจ — ใครก็ปลอมไอพีหลบ rate limit ได้
# ขึ้น Vercel + Render: ค่าที่ถูกต้องคือ proxyHops ของ <URL หน้าเว็บ>/api/health (ดู DEPLOY.md)
TRUST_PROXY=loopback
# secret ที่ Vercel แนบมากับทุกคำขอ — ตั้งแล้ว API รับเฉพาะคำขอที่มาทางหน้าเว็บ (ยกเว้น /api/health) กันคนยิงตรงมาปลอมไอพี
# ต้องยาวอย่างน้อย 32 ตัวและตรงกับค่าใน Vercel · เว้นว่างไว้ตอนพัฒนา (ไม่บังคับ)
PROXY_SECRET=

# ---------- JWT ----------
# สร้างค่าใหม่ด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace_me_with_a_random_64_char_hex_string
JWT_REFRESH_SECRET=replace_me_with_another_random_64_char_hex_string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# ---------- Business rules ----------
SEAT_HOLD_MINUTES=10
REJECTED_RETRY_MINUTES=10
CANCEL_CUTOFF_HOURS=3
MAX_SEATS_PER_BOOKING=8
# ถือที่นั่งค้าง (รอชำระ + รอตรวจสลิป) พร้อมกันได้กี่รายการต่อคน — กันบัญชีเดียววนจองกักที่นั่งทั้งโรง
MAX_PENDING_BOOKINGS_PER_USER=3
# หมดเวลาชำระแล้วยังส่งสลิปได้อีกกี่นาที (0 = ปิด) — สำหรับคนที่โอนแล้วแต่ส่งหลักฐานไม่ทัน (ใช้กับสลิปส่วนต่างเปลี่ยนที่นั่งด้วย)
LATE_SLIP_GRACE_MINUTES=30
# ลูกค้าเปลี่ยนที่นั่งเองได้ถึงก่อนรอบฉายกี่นาที และได้กี่ครั้งต่อการจอง (ผู้ดูแลย้ายแทนได้โดยไม่ติดทั้งสองข้อ)
SEAT_CHANGE_CUTOFF_MINUTES=30
MAX_SEAT_CHANGES_PER_BOOKING=2

# ---------- บัญชีผู้ใช้ / รหัสผ่าน ----------
BCRYPT_ROUNDS=10                # ความแรงในการ hash รหัสผ่าน (สูงขึ้น = ปลอดภัยขึ้นแต่ล็อกอินช้าลง)
LOGIN_LIMIT=10                  # ล็อกอินผิดได้กี่ครั้งต่อ (ไอพี + บัญชี) ครั้งที่สำเร็จไม่นับ
LOGIN_WINDOW_MINUTES=15         # กรอบเวลาที่ใช้นับ (นาที)
REGISTER_LIMIT=50               # สมัครได้กี่บัญชีต่อไอพี ในกรอบเวลาด้านล่าง (นับเฉพาะที่สำเร็จ)
REGISTER_WINDOW_MINUTES=60      # กรอบเวลาที่ใช้นับ (นาที)
PASSWORD_RESET_TTL_MINUTES=30   # อายุลิงก์ตั้งรหัสผ่านใหม่ที่ส่งทางอีเมล
PASSWORD_RESET_LIMIT=5          # ขอลิงก์ได้กี่ครั้งต่อ (ไอพี + อีเมล) ในกรอบเวลาด้านล่าง
PASSWORD_RESET_WINDOW_MINUTES=60

# ---------- อีเมลขาออก (ส่งลิงก์ตั้งรหัสผ่านใหม่ และใบเสร็จหลังอนุมัติสลิป) ----------
# ไม่ตั้ง SMTP_HOST = ยังไม่ส่งอีเมลจริง ระบบจะพิมพ์เนื้อเมลพร้อมลิงก์ลง console ให้แทน (ใช้ตอนพัฒนา)
# ก่อนเปิดใช้งานจริงต้องตั้งค่าให้ครบ ไม่งั้นผู้ใช้ที่ลืมรหัสผ่านจะไม่ได้รับอีเมล และลูกค้าไม่ได้รับใบเสร็จทางอีเมล
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false               # true เมื่อใช้พอร์ต 465 (เข้ารหัสตั้งแต่เชื่อมต่อ) · 587 ใช้ false
SMTP_USER=
SMTP_PASS=
# ต้องเป็นที่อยู่เดียวกับ SMTP_USER (หรือ alias ที่ยืนยันแล้ว)
# Gmail ไม่ยอมให้ส่งในนามอีเมลอื่น จะเขียนทับหรือปฏิเสธทั้งฉบับ
MAIL_FROM="CineBook <no-reply@example.com>"
# ฐานของลิงก์ในอีเมล ต้องเป็น URL ที่ผู้ใช้เปิดจากเครื่องตัวเองได้ — ไม่ตั้งจะใช้ค่า CLIENT_ORIGIN
APP_URL=http://localhost:5173

# ---------- PromptPay ----------
# หมายเลขพร้อมเพย์ปลายทางที่ใช้สร้าง QR — ต้องเปลี่ยนเป็นบัญชีจริงของร้านก่อนเปิดใช้งาน
PROMPTPAY_ID=0812345678
PROMPTPAY_MERCHANT_NAME=THEATRE RESERVATION

# ---------- ใบเสร็จรับเงิน (E-Receipt) ----------
# ชื่อและที่อยู่ผู้ออกใบเสร็จ แสดงบนหน้าใบเสร็จและอีเมลใบเสร็จ (เว้นที่อยู่ว่างไว้ = ไม่แสดงบรรทัดที่อยู่)
RECEIPT_ISSUER_NAME=Sphere Cineplex
RECEIPT_ISSUER_ADDRESS=

# ---------- Uploads ----------
UPLOAD_DIR=uploads
MAX_SLIP_SIZE_MB=5

# ---------- ที่เก็บสลิปบน Supabase Storage (ตอนขึ้นระบบจริง) ----------
# เว้นว่าง = เก็บสลิปลงดิสก์ที่ UPLOAD_DIR (พอสำหรับตอนพัฒนา)
# โฮสต์ที่ดิสก์ไม่ถาวร เช่น Render ต้องตั้ง ไม่งั้นสลิปหายทุกครั้งที่ deploy/restart — วิธีสร้าง bucket ดูใน README
SUPABASE_URL=
# Secret key (sb_secret_…) หรือ service_role key — ข้าม RLS ได้ทั้งหมด ตั้งไว้ที่ API (เช่น Render) เท่านั้น
# ห้ามใส่ใน Vercel หรือตัวแปร VITE_* เด็ดขาด เพราะจะถูก bundle ไปถึงเบราว์เซอร์ของทุกคน
SUPABASE_SECRET_KEY=
# ต้องเป็น bucket แบบ private
SUPABASE_SLIP_BUCKET=slips
