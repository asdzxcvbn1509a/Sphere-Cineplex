<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Storage.Blobs" Version="12.30.1" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="DotNetEnv" Version="3.2.0" />
    <PackageReference Include="FluentValidation" Version="12.2.0" />
    <PackageReference Include="MailKit" Version="4.18.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <!--
    dotnet publish: build หน้าเว็บ React (client/) แล้วใส่ไฟล์ใน client/dist ลง wwwroot ของผลลัพธ์
    publish ครั้งเดียวได้แอปครบทั้ง API และหน้าเว็บ · ข้ามได้ด้วย -p:SkipClientBuild=true (เช่น CI ที่ build หน้าเว็บแยกไว้แล้ว)
    dotnet build / dotnet run / dotnet test ไม่แตะ client — ตอนพัฒนาหน้าเว็บรันจาก Vite ที่ proxy /api มาที่นี่
  -->
  <!--
    git ไม่เก็บโฟลเดอร์ว่าง — clone ใหม่จึงไม่มี wwwroot แล้ว ASP.NET Core เตือนทุกครั้งที่เปิด (หรือล้มถ้าโฟลเดอร์หายหลัง build)
    สร้างไว้ก่อน build เสมอ ตัวหน้าเว็บจริงมาตอน publish (PublishClient ด้านล่าง)
  -->
  <Target Name="EnsureWebRoot" BeforeTargets="BeforeBuild">
    <MakeDir Directories="$(MSBuildProjectDirectory)/wwwroot" />
  </Target>

  <PropertyGroup>
    <ClientRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../../client/'))</ClientRoot>
  </PropertyGroup>

  <Target Name="PublishClient" AfterTargets="ComputeFilesToPublish" Condition="'$(SkipClientBuild)' != 'true'">
    <Error Condition="!Exists('$(ClientRoot)package.json')" Text="ไม่พบหน้าเว็บที่ $(ClientRoot) — publish จากใน repo หรือใส่ -p:SkipClientBuild=true" />
    <Exec WorkingDirectory="$(ClientRoot)" Command="npm ci --no-audit --no-fund" />
    <Exec WorkingDirectory="$(ClientRoot)" Command="npm run build" />
    <ItemGroup>
      <ClientDistFiles Include="$(ClientRoot)dist/**" />
      <ResolvedFileToPublish Include="@(ClientDistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot/%(RecursiveDir)%(FileName)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
